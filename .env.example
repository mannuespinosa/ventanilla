# Gemma 4 + embeddings (Google AI Studio → Get API key)
GEMINI_API_KEY=

# Firecrawl (firecrawl.dev → Dashboard → API Keys)
FIRECRAWL_API_KEY=

# Supabase (dashboard del proyecto → Project Settings → API). Solo para scripts/, nunca en el frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs (elevenlabs.io → Developers → API Keys). La voz se elige en ventanilla.config.json → voz.
ELEVENLABS_API_KEY=

# URLs de las funciones (opcionales; por defecto se usan las de ventanilla.config.json → endpoints)
VITE_ASK_URL=
VITE_VOICE_URL=

# Token para probar `voice` con curl (header X-Ventanilla-Dev); también como secreto en Supabase
VENTANILLA_DEV_TOKEN=
